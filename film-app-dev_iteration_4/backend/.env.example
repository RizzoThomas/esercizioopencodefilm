# =============================================================================
# Backend .env.example — Configurazione per esecuzione standalone (senza Docker)
# =============================================================================
# Questo file è usato quando il backend viene eseguito direttamente con:
#   dotnet run --project backend/FilmAPI/FilmAPI.csproj
#
# NOTA: In docker-compose le variabili sono passate direttamente come env vars
# dal file .env radice. Questo file serve solo per lo sviluppo locale standalone.
# =============================================================================

ASPNETCORE_URLS=http://localhost:5000

# DB (default: MariaDB in locale sulla porta 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=film-api-db
DB_USER=root
DB_PASSWORD=root
DB_USE_AUTODETECT=true
DB_SERVER_VERSION=11.4.0-mariadb

# Path immagini
DEFAULT_COVER_IMAGE_PATH=/media/defaults/cover-default.jpg

# JWT
JWT_SECRET=<chiave segreta minimo 256 bit>
JWT_ISSUER=CineBaseAPI
JWT_AUDIENCE=CineBaseWeb
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Admin seed
ADMIN_SEED_EMAIL=admin@cinebase.it
ADMIN_SEED_PASSWORD=Admin123!

# Application URLs
FRONTEND_BASE_URL=http://localhost:5001
TICKET_VALIDATION_BASE_URL=http://localhost:5001/validazione-biglietti.html

# CORS
ALLOWED_CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# ─── Stripe Payment Configuration ─────────────────────────────────────────
STRIPE_SECRET_API_KEY=<your_stripe_secret_key>
STRIPE_PUBLISHABLE_API_KEY=<your_stripe_publishable_key>
STRIPE_WEBHOOK_SECRET=<your_stripe_webhook_secret>

# ─── Email Configuration ──────────────────────────────────────────────────
# Sviluppo locale (MailDev in Docker): SMTP_HOST=localhost, SMTP_PORT=1025
# Produzione (Gmail):      SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Produzione (SendGrid):   SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cinebase.it
SMTP_FROM_NAME=CineBase

# ─── Ticketing Configuration ──────────────────────────────────────────────
DEFAULT_TICKET_PRICE=8.50
HOLD_TTL_MINUTES=10
MAX_SEATS_PER_ORDER=10

# ─── Account Security Token TTLs ──────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
SET_PASSWORD_TOKEN_TTL_MINUTES=60
ADMIN_INVITE_TOKEN_TTL_HOURS=24
AUTH_EXTERNAL_STATE_TTL_MINUTES=10
AUTH_EXTERNAL_EXCHANGE_TTL_MINUTES=2

# ─── Google OAuth (OpenID Connect) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/external/google/callback

# ─── Microsoft OAuth / Entra ID ───────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:5000/auth/external/microsoft/callback
MICROSOFT_TENANT_ID=<tenant_id_or_organizations>
MICROSOFT_ALLOWED_TENANT_ID=<school_tenant_id>
MICROSOFT_ALLOWED_DOMAIN=issgreppi.it

# ─── Facebook OAuth ───────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── FilmApiSeeder ────────────────────────────────────────────────────────
TMDB_BEARER_TOKEN=<tmdb_bearer_token>
