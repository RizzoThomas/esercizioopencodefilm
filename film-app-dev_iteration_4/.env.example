# =============================================================================
# CineBase Environment Configuration
# =============================================================================
# Copia questo file in .env e modifica i valori necessari.
#
# OBBLIGATORIO per il seeder film:
#   TMDB_BEARER_TOKEN=<il_tuo_token>
#
# Minimo funzionante (solo DB + backend + frontend, senza film):
#   docker-compose up -d
#   → L'app parte con dati di sviluppo di base (admin, categorie)
#   → Il seeder salterà il popolamento film se TMDB_BEARER_TOKEN non è impostato
#
# Completo (con film da TMDB):
#   TMDB_BEARER_TOKEN=<token> docker-compose up -d
#   → Il seeder popolerà 50+ film, 20 cinema, 83 sale, programmazione 7 giorni
# =============================================================================

# ─── ASP.NET Core ───────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS_BACKEND=http://+:8080
ASPNETCORE_URLS_FRONTEND=http://+:8080
ALLOWED_CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# ─── MariaDB Database ───────────────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=film-api-db

DB_HOST=db
DB_PORT=3306
DB_NAME=film-api-db
DB_USER=root
DB_PASSWORD=root
DB_USE_AUTODETECT=true
DB_SERVER_VERSION=11.4.0-mariadb

# ─── Application URLs ───────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5001
TICKET_VALIDATION_BASE_URL=http://localhost:5001/validazione-biglietti.html
DEFAULT_COVER_IMAGE_PATH=/media/defaults/cover-default.jpg

# ─── JWT Authentication ─────────────────────────────────────────────────────
# JWT_SECRET: deve essere una stringa di almeno 32 caratteri (256 bit)
JWT_SECRET=change-me-change-me-change-me-change-me-change-me-change-me
JWT_ISSUER=CineBaseAPI
JWT_AUDIENCE=CineBaseWeb
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── Admin Seed Account ─────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@cinebase.it
ADMIN_SEED_PASSWORD=Admin123!

# ─── Email / SMTP ───────────────────────────────────────────────────────────
# Per sviluppo locale: MailDev (già configurato in docker-compose)
# Non serve modificare nulla — MailDev parte automaticamente
#
# Per SMTP reale (es. Gmail, Twilio SendGrid), decommentare e configurare:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tua.email@gmail.com
# SMTP_PASSWORD=la_tua_app_password
# SMTP_FROM_EMAIL=tua.email@gmail.com
# SMTP_FROM_NAME=CineBase

SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cinebase.it
SMTP_FROM_NAME=CineBase

# ─── Token TTLs ─────────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
SET_PASSWORD_TOKEN_TTL_MINUTES=60
ADMIN_INVITE_TOKEN_TTL_HOURS=24
AUTH_EXTERNAL_STATE_TTL_MINUTES=10
AUTH_EXTERNAL_EXCHANGE_TTL_MINUTES=2

# ─── OAuth - Google ─────────────────────────────────────────────────────────
# Opzionale: lascia vuoto per disabilitare Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/external/google/callback

# ─── OAuth - Microsoft Entra ID ─────────────────────────────────────────────
# Opzionale: lascia vuoto per disabilitare Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:5000/auth/external/microsoft/callback
MICROSOFT_TENANT_ID=
MICROSOFT_ALLOWED_TENANT_ID=
MICROSOFT_ALLOWED_DOMAIN=issgreppi.it

# ─── OAuth - Facebook ───────────────────────────────────────────────────────
# Opzionale: lascia vuoto per disabilitare Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Stripe Payments ────────────────────────────────────────────────────────
# Opzionale: lascia vuoto per disabilitare pagamenti Stripe
STRIPE_SECRET_API_KEY=
STRIPE_PUBLISHABLE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── TMDB (The Movie Database) ──────────────────────────────────────────────
# ⚠️ OBBLIGATORIO per il seeder film
# Ottieni un token da: https://www.themoviedb.org/settings/api
TMDB_BEARER_TOKEN=

# ─── Ticketing ──────────────────────────────────────────────────────────────
DEFAULT_TICKET_PRICE=8.50
HOLD_TTL_MINUTES=10
MAX_SEATS_PER_ORDER=10
